# Keep the golden reference data byte-exact: the .ref files are compressed
# pixel arrays and must never be line-ending normalised.
*.ref binary
*.png binary

# Source and docs: store LF in the repository regardless of platform.
*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.pro text eol=lf
*.properties text eol=lf
gradlew text eol=lf
